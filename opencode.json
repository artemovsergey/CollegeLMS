{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git",
        "@mohak34/opencode-notifier@latest"
    ],
    "skills": {
        "paths": [".opencode/skills"]
    },
    "mcp": {
        "playwright": {
            "type": "local",
            "command": ["npx", "-y", "@playwright/mcp"],
            "enabled": true,
            "environment": {
                "PLAYWRIGHT_BROWSERS_PATH": "0"
            }
        },
        "github": {
            "type": "local",
            "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
            "enabled": true,
            "environment": {
                "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
            }
        }
    },
    "command": {
        "push": {
            "template": "!`scripts/git-push.ps1`",
            "description": "Commit all changes and push to remote using GITHUB_TOKEN"
        },
        "analyze": {
            "template": "!echo '🔍 Starting project analysis...'",
            "description": "Run full project analysis — spec, user stories, plugins, MCP, skills, readiness, phases, agents, models"
        }
    },
    "provider": {
        "routerai": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "RouterAI",
            "options": {
                "baseURL": "https://routerai.ru/api/v1",
                "apiKey": "{env:ROUTERAI_API_KEY}"
            },
            "models": {
                "z-ai/glm-5.3": {"name": "GLM 5.3"},
                "z-ai/glm-5.3-flash": {"name": "GLM 5.3 Flash"},
                "claude-3-5-sonnet": {"name": "Claude 3.5 Sonnet"}
            }
        }
    },
    "model": "opencode-go/deepseek-v4.1-flash"
}
