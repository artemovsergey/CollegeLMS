{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git",
        "@mohak34/opencode-notifier@latest",
        "opencode-worktree",
        "opencode-background-agents",
        "@tarquinen/opencode-dcp",
        "opencode-vibeguard",
        "@plannotator/opencode",
        "opencode-pty"
    ],
    "skills": {
        "paths": [".opencode/skills"]
    },
    "mcp": {
        "playwright": {
            "type": "local",
            "command": ["playwright-mcp"],
            "enabled": true,
            "timeout": 120000,
            "environment": {
                "PLAYWRIGHT_BROWSERS_PATH": "0"
            }
        },
        "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "enabled": true,
            "oauth": false,
            "headers": {
                "Authorization": "Bearer {env:GITHUB_TOKEN}"
            }
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "ms_learn": {
            "type": "remote",
            "url": "https://learn.microsoft.com/api/mcp",
            "enabled": true
        },
        "chrome_devtools": {
            "type": "local",
            "command": ["chrome-devtools-mcp"],
            "enabled": true,
            "timeout": 120000
        }
    },
    "command": {
        "push": {
            "template": "!`scripts/git-push.ps1`",
            "description": "Commit all changes and push to remote using GITHUB_TOKEN"
        },
        "analyze": {
            "template": "Загрузи skill analyze и выполни полный анализ проекта по всем 9 разделам. Выведи отчёт с индикаторами ✅/❌/⚠️ и сводной таблицей.",
            "description": "Run full project analysis — spec, user stories, plugins, MCP, skills, readiness, phases, agents, models"
        }
    },
    "agent": {
        "plan": {
            "model": "opencode-go/gpt-5.6-luna"
        }
    },
    "lsp": {},
    "model": "opencode-go/deepseek-v4.1-flash"
}
