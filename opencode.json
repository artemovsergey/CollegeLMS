{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git",
        "@mohak34/opencode-notifier@latest"
    ],
    "skills": {
        "paths": [".opencode/skills"]
    },
    "mcp": {
        "playwright": {
            "type": "local",
            "command": ["npx", "-y", "@playwright/mcp"],
            "enabled": true,
            "environment": {
                "PLAYWRIGHT_BROWSERS_PATH": "0"
            }
        },
        "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "enabled": true,
            "oauth": false,
            "headers": {
                "Authorization": "Bearer {env:GITHUB_TOKEN}"
            }
        }
    },
    "command": {
        "push": {
            "template": "!`scripts/git-push.ps1`",
            "description": "Commit all changes and push to remote using GITHUB_TOKEN"
        },
        "analyze": {
            "template": "Загрузи skill analyze и выполни полный анализ проекта по всем 9 разделам. Выведи отчёт с индикаторами ✅/❌/⚠️ и сводной таблицей.",
            "description": "Run full project analysis — spec, user stories, plugins, MCP, skills, readiness, phases, agents, models"
        }
    },
    "model": "opencode-go/deepseek-v4.1-flash"
}
