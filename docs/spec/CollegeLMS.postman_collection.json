              "raw": "{\n  \"correctionDate\": \"2026-09-10T00:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/schedule/correction/batches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "schedule",
                "correction",
                "batches"
              ]
            }
          },
          "description": "Создать пакет корректировки по дате (неделя и день недели вычисляются автоматически)"
        },
        {
          "name": "List correction batches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/schedule/correction/batches?status=Draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "schedule",
                "correction",
                "batches"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Draft"
                }
              ]
            }
          },
          "description": "Список пакетов корректировок (status: Draft | Applied | Cancelled, опционально)"
        },
        {
          "name": "Get correction batch",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/schedule/correction/batches/{{batchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "schedule",
                "correction",
                "batches",
                "{{batchId}}"
              ]
            }
          },
          "description": "Пакет корректировки с позициями"
        },
        {
          "name": "Delete correction batch",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/schedule/correction/batches/{{batchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "schedule",
                "correction",
                "batches",
                "{{batchId}}"
              ]
            }
          },
          "description": "Удалить черновой пакет (409 — если пакет не в статусе черновика)"
        },
        {
          "name": "Add correction position",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changeType\": \"Remove\",\n  \"groupId\": \"{{groupId}}\",\n  \"groupName\": \"ПО-262\",\n  \"numberPair\": 2,\n  \"removedSubject\": \"Физика\",\n  \"removedTeacherId\": \"{{teacherId}}\",\n  \"removedTeacherName\": \"Иванов Д.А.\",\n  \"note\": \"сам.р.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/schedule/correction/batches/{{batchId}}/positions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "schedule",
                "correction",
                "batches",
                "{{batchId}}",
                "positions"
              ]
            }
          },
