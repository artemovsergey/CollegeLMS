{
  "info": {
    "name": "CollegeLMS API",
    "description": "API для управления учебным заведением. Требуется JWT-аутентификация.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "courseId",
      "value": "c1000000-0000-0000-0000-000000000001"
    },
    {
      "key": "lessonId",
      "value": ""
    },
    {
      "key": "testId",
      "value": ""
    },
    {
      "key": "questionId",
      "value": ""
    },
    {
      "key": "attemptId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@collegelms.ru\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Upload avatar",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/путь/к/avatar.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/avatar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "avatar"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Get user profile (courses + news)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"newuser\",\n  \"email\": \"newuser@collegelms.ru\",\n  \"password\": \"password123\",\n  \"fullName\": \"Новый пользователь\",\n  \"role\": \"Student\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"updateduser\",\n  \"email\": \"updated@collegelms.ru\",\n  \"fullName\": \"Обновлённый пользователь\",\n  \"role\": \"Teacher\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Delete user (hard delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Change user role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Dispatcher\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "role"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tests",
      "item": [
        {
          "name": "Create test with lesson",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Тест к занятию 1\",\n  \"description\": \"Проверка усвоения материала занятия\",\n  \"timeLimitMinutes\": 30,\n  \"maxAttempts\": 2,\n  \"type\": \"SelfStudy\",\n  \"passingScore\": 60,\n  \"courseId\": \"{{courseId}}\",\n  \"lessonId\": \"{{lessonId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tests"
              ]
            }
          }
        },
        {
          "name": "Get tests by course",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tests?courseId={{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tests"
              ],
              "query": [
                {
                  "key": "courseId",
                  "value": "{{courseId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Start test",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tests/{{testId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tests",
                "{{testId}}",
                "start"
              ]
            }
          }
        },
        {
          "name": "Submit answers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"questionId\": \"{{questionId}}\", \"givenAnswer\": \"A\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tests/{{testId}}/attempt/{{attemptId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tests",
                "{{testId}}",
                "attempt",
                "{{attemptId}}",
                "submit"
              ]
            }
          }
        },
        {
          "name": "Get my result",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tests/{{testId}}/results",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tests",
                "{{testId}}",
                "results"
              ]
            }
          }
        },
        {
          "name": "Get my test results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/my/test-results",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "my",
                "test-results"
              ]
            }
          }
        },
        {
          "name": "Get test stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tests/{{testId}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tests",
                "{{testId}}",
                "stats"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Duplicate course",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}/duplicate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "{{courseId}}",
                "duplicate"
              ]
            }
          }
        },
        {
          "name": "Set course active",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "{{courseId}}",
                "active"
              ]
            }
          }
        },
        {
          "name": "Lessons",
          "item": [
            {
              "name": "Get lessons",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/lessons",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "lessons"
                  ]
                }
              },
              "description": "Список занятий курса"
            },
            {
              "name": "Get lesson by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/lessons/{{lessonId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "lessons",
                    "{{lessonId}}"
                  ]
                }
              },
              "description": "Занятие по ID"
            },
            {
              "name": "Create lesson",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/lessons",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "lessons"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Введение\",\n  \"content\": \"Описание занятия\",\n  \"kind\": \"Lecture\",\n  \"testId\": null,\n  \"afterLessonId\": null\n}"
                }
              },
              "description": "Создать занятие (после занятия или в начало)"
            },
            {
              "name": "Update lesson",
              "request": {
                "method": "PUT",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/lessons/{{lessonId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "lessons",
                    "{{lessonId}}"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Введение\",\n  \"content\": \"Обновлённое содержание\",\n  \"kind\": \"Practice\",\n  \"testId\": null\n}"
                }
              },
              "description": "Обновить занятие"
            },
            {
              "name": "Reorder lessons",
              "request": {
                "method": "PUT",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/lessons/reorder",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "lessons",
                    "reorder"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"lessonIds\": []\n}"
                }
              },
              "description": "Переупорядочивание занятий"
            },
            {
              "name": "Set current lesson",
              "request": {
                "method": "PATCH",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/lessons/{{lessonId}}/current",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "lessons",
                    "{{lessonId}}",
                    "current"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"isCurrent\": true\n}"
                }
              },
              "description": "Пометить занятие как текущее"
            },
            {
              "name": "Delete lesson",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/lessons/{{lessonId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "lessons",
                    "{{lessonId}}"
                  ]
                }
              },
              "description": "Удалить занятие"
            }
          ]
        },
        {
          "name": "Documents",
          "item": [
            {
              "name": "Upload document",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "type": "file",
                      "src": []
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/documents",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "documents"
                  ]
                }
              },
              "description": "Загрузить документ в курс (form-data, file)"
            },
            {
              "name": "Get documents",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/documents",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "documents"
                  ]
                }
              },
              "description": "Список документов курса"
            },
            {
              "name": "Download document",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/documents/{{documentId}}/download",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "documents",
                    "{{documentId}}",
                    "download"
                  ]
                }
              },
              "description": "Скачать файл документа"
            },
            {
              "name": "Delete document",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/courses/{{courseId}}/documents/{{documentId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "courses",
                    "{{courseId}}",
                    "documents",
                    "{{documentId}}"
                  ]
                }
              },
              "description": "Удалить документ"
            }
          ]
        }
      ]
    }
  ]
}