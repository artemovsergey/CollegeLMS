@startuml
!theme plain
title Корректировки: пакеты и позиции — Class

interface ICorrectionBatchService {
  + CreateBatchAsync(request, createdByUserId, ct): Result<CorrectionBatchResponse>
  + GetBatchesAsync(status?, from?, to?, page?, pageSize?, ct): Result<PagedResponse<CorrectionBatchResponse>>
  + GetBatchAsync(id, ct): Result<CorrectionBatchResponse>
  + DeleteBatchAsync(id, ct): Result
  + AddPositionAsync(batchId, request, ct): Result<CorrectionPositionResponse>
  + UpdatePositionAsync(batchId, positionId, request, ct): Result<CorrectionPositionResponse>
  + DeletePositionAsync(batchId, positionId, ct): Result
  + ImportAsync(fileStream, createdByUserId, ct): Result<CorrectionImportResponse>
  + ExportAsync(batchId, ct): Result<DocumentDownloadResult>
  + ApplyAsync(batchId, idempotencyKey, appliedByUserId, ct): Result<CorrectionApplyResult>
}

class CorrectionBatchService {
  - db: AppDbContext
  - correctionService: IScheduleCorrectionService
  - engine: CorrectionApplyEngine
  - imageService: CorrectionImageService
  - maxBot: MaxBotHttpClient
  - logger: ILogger<CorrectionBatchService>
  + CreateBatchAsync(request, createdByUserId, ct): Result<CorrectionBatchResponse>
  + GetBatchesAsync(status?, from?, to?, page?, pageSize?, ct): Result<PagedResponse<CorrectionBatchResponse>>
  + GetBatchAsync(id, ct): Result<CorrectionBatchResponse>
  + DeleteBatchAsync(id, ct): Result
  + AddPositionAsync(batchId, request, ct): Result<CorrectionPositionResponse>
  + UpdatePositionAsync(batchId, positionId, request, ct): Result<CorrectionPositionResponse>
  + DeletePositionAsync(batchId, positionId, ct): Result
  + ImportAsync(fileStream, createdByUserId, ct): Result<CorrectionImportResponse>
  + ExportAsync(batchId, ct): Result<DocumentDownloadResult>
  + ApplyAsync(batchId, idempotencyKey, appliedByUserId, ct): Result<CorrectionApplyResult>
  - TrySendCorrectionImageAsync(batch, ct): Task
  - ValidatePositionAsync(request, ct): Task<string?>
  - ResolveNote(request): string?
  - ToManualRow(position): ManualCorrectionRow
}

class CorrectionBatchController {
  - service: ICorrectionBatchService
  + CreateBatch(request, ct): ActionResult          // POST /api/schedule/correction/batches
  + GetBatches(status, from, to, page, pageSize, ct): ActionResult
  + GetBatch(id, ct): ActionResult
  + DeleteBatch(id, ct): ActionResult
  + AddPosition(id, request, ct): ActionResult
  + UpdatePosition(id, positionId, request, ct): ActionResult
  + DeletePosition(id, positionId, ct): ActionResult
  + Import(file, ct): ActionResult                  // multipart XLSX
  + Export(id, ct): ActionResult                    // XLSX «Корректировка_dd.MM.yyyy_HH-mm-ss.xlsx»
  + Apply(id, ct): ActionResult                     // транзакция + история + уведомления
}

class CorrectionApplyEngine {
  - db: AppDbContext
  + ValidateBatchAsync(batch, ct): Task<List<ScheduleValidationError>>
  + ExecuteBatchAsync(batch, appliedByUserId, ct): Task<CorrectionApplyOutcome>
  + BuildEffectiveEntriesAsync(groupId, day, week, batchId, ct): Task<List<SimulatedEntry>>
  - SimulateAsync(positions, execute, appliedByUserId, correctionDate, ct, forcedTargets?): Task<SimulationResult>
  - FindEntry(list, numberPair, subject, teacherId, teacherName): SimulatedEntry?
  - RemoveWeekOrDelete(entity, week, utcNow): void
  - Error(row, column, text): ScheduleValidationError
}

class SimulatedEntry {
  + GroupId: Guid
  + DayOfWeek: DayOfWeek
  + Week: int
  + NumberPair: int
  + Subject: string
  + TeacherName: string?
  + Note: string?
  + IsSelfStudy: bool
  + Removed: bool
  + PendingChangeType: string?
  + Entity: ScheduleEntry?
}

class CorrectionApplyOutcome {
  + History: List<ScheduleHistory>
  + Changes: List<ScheduleChangeDto>
}

class CorrectionImageService {
  + Render(batch): byte[]
  - Describe(position): (string, string)
  - PairLabel(position): string
  - ChangeTypeLabel(changeType): string
}

class MaxBotHttpClient {
  - http: HttpClient
  - logger: ILogger<MaxBotHttpClient>
  + SendChangesAsync(changes, ct): Task           // POST /notify (fail-safe)
  + SendCorrectionImageAsync(png, caption, ct): Task  // POST /notify/correction-image (fail-safe)
}

interface IScheduleCorrectionService {
  + PreviewAsync(file, ct): Result<CorrectionPreviewResponse>
  + ExportManualAsync(request, ct): Result<DocumentDownloadResult>
  + ConfirmAsync(request, idempotencyKey, appliedByUserId, ct): Result<CorrectionConfirmResult>
  + ApplyEntriesAsync(entries, appliedByUserId, correctionDate, ct): Result<List<ScheduleChangeDto>>
  + GetDayAsync(groupId, date, batchId, ct): Result<CorrectionDayResponse>
  + GetHistoryAsync(groupId, teacherId, week, date, from, to, changeType, page, pageSize, ct): Result<PagedResponse<ScheduleHistoryResponse>>
}

class ScheduleCorrectionService {
  - db: AppDbContext
  - maxBot: MaxBotHttpClient
  - engine: CorrectionApplyEngine
  + PreviewAsync(file, ct): Result<CorrectionPreviewResponse>
  + ExportManualAsync(request, ct): Result<DocumentDownloadResult>
  + ConfirmAsync(request, idempotencyKey, appliedByUserId, ct): Result<CorrectionConfirmResult>
  + ApplyEntriesAsync(entries, appliedByUserId, correctionDate, ct): Result<List<ScheduleChangeDto>>
  + GetDayAsync(groupId, date, batchId, ct): Result<CorrectionDayResponse>
  + GetHistoryAsync(...): Result<PagedResponse<ScheduleHistoryResponse>>
}

class CorrectionBatch {
  + Id: Guid
  + CorrectionDate: DateTime
  + Week: int
  + DayOfWeek: int
  + Status: CorrectionBatchStatus
  + AppliedByUserId: Guid?
  + AppliedAt: DateTime?
  + Positions: List<CorrectionPosition>
}

class CorrectionPosition {
  + Row: int
  + ChangeType: ScheduleChangeType
  + GroupId: Guid
  + Week: int
  + NumberPair: int
  + Note: string?
  + Status: CorrectionPositionStatus
  + HistoryId: Guid?
}

class ScheduleEntry {
  + Id: Guid
  + GroupId: Guid
  + TeacherId: Guid?
  + Subject: string
  + DayOfWeek: DayOfWeek
  + NumberPair: int
  + Weeks: List<int>
}

class ScheduleHistory {
  + Id: Guid
  + ChangeType: ScheduleChangeType
  + AppliedAt: DateTime
  + GroupId: Guid
  + TeacherId: Guid?
  + Week: int
  + NumberPair: int
  + Note: string?
  + RemovedSubject: string?
  + RemovedTeacherName: string?
  + RemovedNumberPair: int?
}

ICorrectionBatchService <|.. CorrectionBatchService
CorrectionBatchController --> ICorrectionBatchService
IScheduleCorrectionService <|.. ScheduleCorrectionService
CorrectionBatchService --> IScheduleCorrectionService : Preview / ExportManual / ApplyEntries
CorrectionBatchService --> CorrectionApplyEngine : Validate / Execute
CorrectionBatchService --> CorrectionImageService : Render после apply
CorrectionBatchService --> MaxBotHttpClient : SendChanges / SendCorrectionImage
ScheduleCorrectionService --> CorrectionApplyEngine : GetDay / BuildEffectiveEntries
CorrectionBatchService --> CorrectionBatch : CRUD
CorrectionBatchService --> CorrectionPosition : CRUD
CorrectionApplyEngine ..> SimulatedEntry : создаёт
CorrectionApplyEngine ..> CorrectionApplyOutcome : возвращает
CorrectionApplyEngine --> ScheduleEntry : чтение / Weeks / удаление
CorrectionApplyEngine --> ScheduleHistory : INSERT
CorrectionImageService ..> CorrectionBatch : читает позиции
CorrectionBatch o--o{ CorrectionPosition : positions
@enduml
