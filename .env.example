# Database
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=collegelms

# Redis
REDIS_PORT=6379

# API
API_PORT=5026
ASPNETCORE_ENVIRONMENT=Production

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
CERTBOT_EMAIL=

# Max Bot
MAX_BOT_TOKEN=
# Секрет вебхука MAX (5-256 символов [A-Za-z0-9_-]) — обязателен в деплое
MAX_BOT_WEBHOOK_SECRET=
# Секрет внутреннего endpoint профиля бота (заголовок X-Internal-Secret) — обязателен в деплое
MAXBOT_INTERNAL_SECRET=
# Публичное имя бота — поле web_app у кнопок open_app — обязательно в деплое
MAX_BOT_PUBLIC_NAME=
# URL вебхука (есть дефолт в compose: https://stvcc.tech/maxbot/webhook)
MAX_BOT_WEBHOOK_URL=
# Опционально (есть дефолты в compose): URL мини-приложения и имя БД MaxBot
MAX_MINI_APP_URL=
MAX_BOT_DB_NAME=

# JWT (обязательно, минимум 32 символа)
JWT_KEY=
