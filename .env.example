# Database
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=collegelms

# Redis
REDIS_PORT=6379

# API
API_PORT=5026
ASPNETCORE_ENVIRONMENT=Production

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PUBLIC_DOMAIN=stvcc.tech
CERTBOT_EMAIL=

